# 简化版配置 - 无需数据库
# 适用于测试和开发

# 阿里云百炼 API Key (必需)
# 获取地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 使用的模型
DASHSCOPE_MODEL=qwen-plus

# SearchAPI Key (可选，用于联网搜索功能)
# 获取地址: https://www.searchapi.io/
SEARCH_API_KEY=

# 服务器配置
SERVER_PORT=8123

# 应用环境
SPRING_PROFILES_ACTIVE=local
